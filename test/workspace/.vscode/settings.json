{
	// Mirrored so a browser session is readable in the developer console without
	// setting anything first. Neither the level nor the target is pinned here: set
	// them for the session instead, since a workspace value outranks the
	// user-scoped writes the integration gate makes, and a pinned `target` silently
	// turns every switch in the gate into a no-op.
	"micropython-lsp.mirrorLogsToConsole": true
}
